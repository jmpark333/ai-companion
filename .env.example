# Supabase 설정
# https://supabase.com → 프로젝트 → Settings → API

# Supabase Project URL
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase Service Role Key (비밀 키! 공개하지 마세요)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Z.AI API 설정 (선택사항 - 클라이언트에서 설정 가능)
# ZAI_API_KEY=your_zai_api_key_here

# 참고:
# - .env 파일은 로컬 개발용입니다
# - Netlify 배포 시에는 Netlify Dashboard의 Environment Variables에 설정하세요
# - 이 파일(.env.example)은 Git에 커밋해도 됩니다 (실제 값이 없으므로)
# - 실제 .env 파일은 .gitignore에 포함되어 Git에서 제외됩니다
